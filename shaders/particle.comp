#version 450

layout(local_size_x = 256) in;

struct Particle
{
    vec2 position;
    vec2 velocity;
    vec4 color;
};

layout(std430, binding = 0) readonly buffer InputParticles
{
    Particle particlesIn[];
};

layout(std430, binding = 1) writeonly buffer OutputParticles
{
    Particle particlesOut[];
};

layout(push_constant) uniform SimulationParameters
{
    float deltaTime;
    uint integrate;
} simulation;

const float BOUNDARY = 0.98;
const float RADIUS = 0.003;
const float RESTITUTION = 1.0;
const float POSITION_CORRECTION = 0.8;
const float COLLISION_SLOP = 0.0001;

void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= particlesIn.length())
        return;

    Particle particle = particlesIn[index];

    // Integration happens only during the first iteration.
    if (simulation.integrate != 0)
    {
        float dt = clamp(simulation.deltaTime, 0.0, 0.033);

        particle.position += particle.velocity * dt;

        // Boundary collisions.
        if (particle.position.x < -BOUNDARY + RADIUS)
        {
            particle.position.x = -BOUNDARY + RADIUS;
            particle.velocity.x = abs(particle.velocity.x) * RESTITUTION;
        }
        else if (particle.position.x > BOUNDARY - RADIUS)
        {
            particle.position.x = BOUNDARY - RADIUS;
            particle.velocity.x = -abs(particle.velocity.x) * RESTITUTION;
        }

        if (particle.position.y < -BOUNDARY + RADIUS)
        {
            particle.position.y = -BOUNDARY + RADIUS;
            particle.velocity.y = abs(particle.velocity.y) * RESTITUTION;
        }
        else if (particle.position.y > BOUNDARY - RADIUS)
        {
            particle.position.y = BOUNDARY - RADIUS;
            particle.velocity.y = -abs(particle.velocity.y) * RESTITUTION;
        }

        particlesOut[index] = particle;
        return;
    }

    // Accumulate corrections without modifying the particle
    // while processing individual collisions.
    vec2 velocityCorrection = vec2(0.0);
    vec2 positionCorrection = vec2(0.0);

    const float minimumDistance = RADIUS * 2.0;
    const float minimumDistanceSquared =
        minimumDistance * minimumDistance;

    for (uint i = 0; i < particlesIn.length(); ++i)
    {
        if (i == index)
            continue;

        Particle other = particlesIn[i];

        vec2 difference = particle.position - other.position;
        float distanceSquared = dot(difference, difference);

        if (distanceSquared >= minimumDistanceSquared)
            continue;

        float distance = sqrt(max(distanceSquared, 0.000001));
        vec2 normal = difference / distance;

        // Positional correction.
        float overlap = minimumDistance - distance;

        float correction = max(overlap - COLLISION_SLOP, 0.0);

        positionCorrection += normal * correction * 0.5 * POSITION_CORRECTION;

        // Elastic collision response.
        vec2 relativeVelocity = particle.velocity - other.velocity;

        float velocityAlongNormal =
            dot(relativeVelocity, normal);

        // Only resolve approaching particles.
        if (velocityAlongNormal < 0.0)
        {
            float impulse = -(1.0 + RESTITUTION) * velocityAlongNormal * 0.5;
            velocityCorrection += impulse * normal;
        }
    }

    // Apply all accumulated corrections together.
    particle.position += positionCorrection;
    particle.velocity += velocityCorrection;

    particlesOut[index] = particle;
}
